{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/channels.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/countries.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/filter.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/channels(.*)",
      "dest": "/api/channels.js"
    },
    {
      "src": "/api/countries(.*)",
      "dest": "/api/countries.js"
    },
    {
      "src": "/api/filter(.*)",
      "dest": "/api/filter.js"
    },
    {
      "src": "/assets/.*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}